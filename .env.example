# =============================================================================
# GOLD-AI 环境变量示例
# 使用方式：复制为 .env 后按本地环境修改（.env 不入 Git）
# =============================================================================

# 运行环境：development / test / production
APP_ENV=development

# 主数据库：**生产 / 研究环境必须使用 PostgreSQL**（docs/03 第 1 节）。
# 本地无 PostgreSQL 时可临时使用 SQLite，但仅限开发与测试：
# 它不保存时区偏移、缺少 JSONB/原生 UUID、无并发写入与分区能力。
#   DATABASE_URL=sqlite+pysqlite:///./data/normalized/gold_ai_dev.db
DATABASE_URL=postgresql+psycopg://gold_ai:gold_ai@localhost:5432/gold_ai

# Redis：任务队列 / 短期缓存 / 分布式锁
REDIS_URL=redis://localhost:6379/0

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# =============================================================================
# 实盘安全门禁（最高级别红线，MVP 阶段禁止修改为 true）
# 06_Cline开发规则 第 18 条：任何把下列开关设为 true 的行为都会被配置层直接拒绝。
# =============================================================================
LIVE_TRADING=false
ALLOW_EXTERNAL_ORDER_SUBMISSION=false

# =============================================================================
# DeepSeek（Phase 2 LLM 观点抽取器；`src/processors/llm_client.py`）
# 安全约定（最高级别）：
#   1. 密钥**只能**来自本文件或环境变量，禁止硬编码、禁止用命令行参数传
#      （传参会进入 shell 历史与进程列表，等于泄漏）；
#   2. 代码侧用 `SecretStr` 存 Key：`repr()` / 日志里显示为 **********；
#   3. 客户端从不 print 任何含 Key 的内容，所有异常消息与返回内容统一过 `redact()`；
#   4. 未配置 Key 时：`auto` 模式报配置错误、`readonly` 模式可**纯缓存复跑**（零成本）。
# =============================================================================
# 在 https://platform.deepseek.com 申请后填入；填完请确认 .env 已被 .gitignore 覆盖
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 2026-09-13 实测：GET /models 只返回 deepseek-flash / deepseek-v4-pro；
# 旧名 deepseek-chat 仍可调用但被静默路由到 flash（模型名进缓存键，故写实际模型名）。
DEEPSEEK_MODEL=deepseek-flash
# 思考模式：disabled（默认，抽取任务推荐） / enabled（会多花输出 token 且更慢）
DEEPSEEK_THINKING_MODE=disabled
